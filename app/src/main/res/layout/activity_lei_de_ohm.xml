<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Lei de Ohm (V = R * I)"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Selecione o que deseja calcular e preencha os outros dois campos." />

        <RadioGroup
            android:id="@+id/radioGroupOhm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioTensao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tensão (V)" />

            <RadioButton
                android:id="@+id/radioCorrente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corrente (I)" />

            <RadioButton
                android:id="@+id/radioResistencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resistência (R)" />

        </RadioGroup>

        <EditText
            android:id="@+id/edtTensao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tensão (V)"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edtCorrente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Corrente (A)"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edtResistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Resistência (Ω)"
            android:inputType="numberDecimal|numberSigned" />

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calcular" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
