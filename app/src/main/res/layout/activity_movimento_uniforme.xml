<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Movimento Uniforme (MU)"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Preencha os dois campos conhecidos e marque o que deseja calcular." />

        <EditText
            android:id="@+id/edtDistancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Distância (m)"
            android:inputType="numberDecimal|numberSigned" />
        <CheckBox
            android:id="@+id/chkDistancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calcular Distância (d = v * t)" />

        <EditText
            android:id="@+id/edtVelocidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Velocidade (m/s)"
            android:inputType="numberDecimal|numberSigned" />
        <CheckBox
            android:id="@+id/chkVelocidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calcular Velocidade (v = d / t)" />

        <EditText
            android:id="@+id/edtTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tempo (s)"
            android:inputType="numberDecimal|numberSigned" />
        <CheckBox
            android:id="@+id/chkTempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calcular Tempo (t = d / v)" />

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calcular" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
