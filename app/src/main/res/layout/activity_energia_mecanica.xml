<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Energia Mecânica"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtMassa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Massa (kg)"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edtAltura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Altura (m)"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edtVelocidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Velocidade (m/s)"
            android:inputType="numberDecimal|numberSigned" />

        <CheckBox
            android:id="@+id/chkEp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Energia Potencial (Ep = m*g*h)" />

        <CheckBox
            android:id="@+id/chkEc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Energia Cinética (Ec = m*v²/2)" />

        <CheckBox
            android:id="@+id/chkEm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Energia Mecânica (Em = Ep + Ec)" />

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calcular" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
